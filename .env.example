# Telegram API credentials (create at https://my.telegram.org)
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Where to store the Telethon session file
TELEGRAM_SESSION_PATH=./data/telegram.session

# Chat identifier: username (e.g. mychannel) OR numeric id
TELEGRAM_CHAT=my_music_chat

# App storage
DATA_DIR=./data
DOWNLOADS_DIR=./data/downloads
DB_PATH=./data/playgram.sqlite3

# Sync settings
SYNC_TELEGRAM_ENABLED=true  # Set to false to skip Telegram sync (local scan only)
SYNC_LIMIT=200
SYNC_READ_DELAY_SECONDS=0.05
DOWNLOAD_DELAY_SECONDS=1.5
